rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@fanbasetickets.net';
    }
    // Owner scoping (Crew Tier Phase 1a): businessId === ownerUid, so a doc's
    // gardenerUid IS its owning business/account. Only the owner (or admin, via
    // firestoreRest) may touch their business data. Closes the prior multi-tenant
    // hole where `request.auth != null` let any contractor read another's book.
    // (Crew Worker access is added in Phase 1b via a memberships lookup.)
    function isOwner(bizUid) {
      return request.auth != null && request.auth.uid == bizUid;
    }
    // Crew Tier Phase 1b: membership docs use a deterministic id `{bizUid}_{memberUid}`
    // (written server-side via firestoreRest on invite-accept), so a rule can look up
    // the caller's membership in a business directly. A Worker gets scoped access to
    // ONLY the jobs assigned to them in that business.
    function membershipPath(bizUid) {
      return /databases/$(database)/documents/memberships/$(bizUid + '_' + request.auth.uid);
    }
    function isActiveMember(bizUid) {
      return request.auth != null
        && exists(membershipPath(bizUid))
        && get(membershipPath(bizUid)).data.status == 'active';
    }
    function isActiveWorker(bizUid) {
      return isActiveMember(bizUid) && get(membershipPath(bizUid)).data.role == 'worker';
    }
    match /users/{uid} {
      allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == uid);
    }
    match /subscriptions/{uid} {
      allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == uid);
    }
    match /clients/{doc} {
      allow read, update, delete: if isAdmin() || isOwner(resource.data.gardenerUid);
      allow create:              if isAdmin() || isOwner(request.resource.data.gardenerUid);
    }
    match /schedules/{doc} {
      // Owner: full. Worker: read + update ONLY jobs assigned to them, and only
      // the job-status/photo fields (can't reassign, change the business, or see
      // money — schedules carry denormalized clientName/serviceAddress/serviceLabel,
      // never price). Create/delete stay owner-only.
      allow read:   if isAdmin() || isOwner(resource.data.gardenerUid)
                       || (isActiveWorker(resource.data.gardenerUid) && resource.data.assignedTo == request.auth.uid);
      allow create: if isAdmin() || isOwner(request.resource.data.gardenerUid);
      allow delete: if isAdmin() || isOwner(resource.data.gardenerUid);
      allow update: if isAdmin() || isOwner(resource.data.gardenerUid)
                       || (isActiveWorker(resource.data.gardenerUid)
                            && resource.data.assignedTo == request.auth.uid
                            && request.resource.data.gardenerUid == resource.data.gardenerUid
                            && request.resource.data.assignedTo == resource.data.assignedTo
                            && request.resource.data.diff(resource.data).affectedKeys()
                                 .hasOnly(['status', 'completedAt', 'completedBy', 'photos', 'updatedAt']));
    }
    match /services/{doc} {
      allow read, update, delete: if isAdmin() || isOwner(resource.data.gardenerUid);
      allow create:              if isAdmin() || isOwner(request.resource.data.gardenerUid);
    }
    match /invoices/{doc} {
      allow read, update, delete: if isAdmin() || isOwner(resource.data.gardenerUid);
      allow create:              if isAdmin() || isOwner(request.resource.data.gardenerUid);
    }
    match /feePayments/{doc} {
      allow read, update, delete: if isAdmin() || isOwner(resource.data.gardenerUid);
      allow create:              if isAdmin() || isOwner(request.resource.data.gardenerUid);
    }
    match /icalEvents/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /smsStatus/{doc} {
      // SMS delivery status records written by the Twilio status-callback
      // handler (server-side, authed as admin via lib/firestoreRest.js).
      // Admin-only access — these docs contain client phone numbers and
      // would leak across contractors if reads were broad-authenticated.
      // When a contractor-facing UI for delivery status is built, replace
      // with a scoped rule (resource.data.gardenerUid == request.auth.uid)
      // or proxy reads through a server-side API endpoint.
      allow read, write: if isAdmin();
    }
    match /slugs/{slug} {
      // Public-URL slug resolver collection for the Smart Business Card
      // feature (see docs/SMART_BUSINESS_CARD_SPEC.md §1.4). Every read +
      // write path goes through server-side lib/firestoreRest.js
      // (admin-authed) — the public /join/[slug] page reads via the
      // server component, /api/slug/check uses firestoreRest, and
      // /api/slug/generate uses firestoreRest. Contractors never write
      // directly from the client SDK. Admin-only is sufficient.
      allow read, write: if isAdmin();
    }
    match /rateLimits/{slug} {
      // Per-slug spam throttle for the public intake form. Read-modify-
      // write happens server-side in /api/join/submit (admin-authed via
      // firestoreRest). Never touched by client code.
      allow read, write: if isAdmin();
    }
    match /referralCards/{doc} {
      // Founder referral-card profile shown on /grow (name, title, headshot
      // + visibility toggles). Read + write only via server-side
      // lib/firestoreRest.js (admin-authed): the admin editor writes it
      // through /api/admin/referral-card and /grow reads it server-side.
      // Never touched by client SDK. Admin-only is sufficient.
      allow read, write: if isAdmin();
    }
    match /settings/{doc} {
      // Platform-wide admin config (settings/platform: SMS-cron master switch,
      // future toggles). Read + write only via server-side lib/firestoreRest.js
      // (admin-authed): the admin dashboard writes it through
      // /api/admin/cron-control and the SMS cron reads it server-side. Never
      // touched by client SDK. Admin-only is sufficient.
      allow read, write: if isAdmin();
    }
    match /quotes/{doc} {
      // Quotes (F14) — every read/write goes through server-side
      // lib/firestoreRest.js (admin-authed): the contractor list + builder use
      // /api/quotes, and the public /quote/[id] page reads + the e-sign
      // accept/decline write via /api/quotes/[id]/*. Quotes hold client PII
      // (name/phone/email + signature IP), so broad-authenticated reads would
      // leak across contractors — admin-only, accessed only via the server.
      allow read, write: if isAdmin();
    }
    match /businesses/{bizUid} {
      // businessId === ownerUid. Owner + active members can read (name/branding);
      // only the owner (or admin) writes.
      allow read:  if isAdmin() || isOwner(bizUid) || isActiveMember(bizUid);
      allow write: if isAdmin() || isOwner(bizUid);
    }
    match /memberships/{id} {
      // Read: the member themselves, the business owner, or admin. Write: SERVER
      // ONLY (admin via firestoreRest) — invites + accepts go through the Team API
      // routes so a worker can never self-grant a role or flip their own status.
      allow read:  if isAdmin()
                      || (request.auth != null && request.auth.uid == resource.data.memberUid)
                      || isOwner(resource.data.businessUid);
      allow write: if isAdmin();
    }
  }
}
